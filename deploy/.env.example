# A szerveres telepítés környezete (terv 7.3; kiemelési terv WP49). A szerveren: /srv/media-server/.env, kézzel
# (README: Első telepítés). Kulcs NEM kerül ide. A deploy.sh ebből csak az IMAGE_TAG és a PREVIOUS_IMAGE_TAG sort írja.

# A médiafájlok gyökere (csak olvasva csatolva, a konténerben /srv/media); az apps.json `dir`-jei ez alatt.
MEDIA_ROOT=/srv/media-server/data

# Az apps.json (kulcsok, origins, corp) – csak a szerveren, 0400; relatív útvonal a DEPLOY_DIR-hez képest.
APPS_JSON=./secrets/apps.json

# A futó image címkéje (media-server:<IMAGE_TAG>) és az előző (a --rollback célja). A deploy.sh írja; üresen hagyható.
IMAGE_TAG=
PREVIOUS_IMAGE_TAG=

# Kiadott port: csak a loopbackre (a TLS-t a host-nginx végzi, host-nginx.conf.example).
BIND=127.0.0.1
PORT=10090

# A compose-hálózat rögzített alhálózata; a NET_GATEWAY-t bízza meg a real_ip (X-Forwarded-For).
NET_SUBNET=172.29.90.0/24
NET_GATEWAY=172.29.90.1

COMPOSE_PROJECT_NAME=media-server

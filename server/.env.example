# A médiaszerver helyi compose-környezete (terv 7.2). Másold .env néven; kulcs NEM kerül ide.
# Egy célgép telepítésének környezete külön: ../deploy/.env.example (és ../deploy/target.env.example).

# Az image (a compose a Dockerfile-ból építi: docker compose up -d --build).
MEDIA_IMAGE=media-server:dev

# A médiafájlok gyökere (csak olvasva csatolva, a konténerben /srv/media); az apps.json `dir`-jei ez alatt.
# Szintetikus mintamédia: `pnpm dev-media`; apps.local.json: demo → "dir": "demo".
MEDIA_ROOT=./dev-media

# Az apps.json (kulcsok, origins, corp; terv 4.3) – gitignore-olt.
APPS_JSON=./secrets/apps.local.json

# Kiadott port: csak a loopbackre.
BIND=127.0.0.1
PORT=10090

# A compose-hálózat rögzített alhálózata; a NET_GATEWAY-t bízza meg a real_ip (X-Forwarded-For).
NET_SUBNET=172.29.90.0/24
NET_GATEWAY=172.29.90.1

COMPOSE_PROJECT_NAME=media-server

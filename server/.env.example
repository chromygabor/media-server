# A médiaszerver compose-környezete (terv 7.2, 7.3). Másold .env néven; kulcs NEM kerül ide.

# A médiafájlok gyökere (csak olvasva csatolva, a konténerben /srv/media); az apps.json `dir`-jei ez alatt.
#   helyben:   ./dev-media             (apps.local.json: elearning → "dir": ".")
#   szerveren: /srv/media-server/data           (apps.json: elearning → "dir": "elearning")
MEDIA_ROOT=./dev-media

# Az apps.json (kulcsok, origins, corp; terv 4.3) – gitignore-olt, a szerveren 0400.
#   helyben:   ./secrets/apps.local.json
#   szerveren: ./secrets/apps.json
APPS_JSON=./secrets/apps.local.json

# Kiadott port: csak a loopbackre (a TLS-t a host-nginx végzi).
BIND=127.0.0.1
PORT=10090

# A compose-hálózat rögzített alhálózata; a NET_GATEWAY-t bízza meg a real_ip (X-Forwarded-For).
NET_SUBNET=172.29.90.0/24
NET_GATEWAY=172.29.90.1

COMPOSE_PROJECT_NAME=media-server

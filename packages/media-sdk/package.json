{
  "name": "@chromygabor/media-sdk",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chromygabor/media-server.git",
    "directory": "packages/media-sdk"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "media-keys": "./bin/media-keys.js",
    "media-sign": "./bin/media-sign.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./apps-config": {
      "import": {
        "types": "./dist/apps-config.d.ts",
        "default": "./dist/apps-config.js"
      },
      "require": {
        "types": "./dist/apps-config.d.cts",
        "default": "./dist/apps-config.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./test-vectors.json": "./test-vectors.json"
  },
  "files": [
    "dist",
    "bin",
    "test-vectors.json",
    "SPEC.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint --type-aware src/",
    "check:standalone": "bash scripts/check-standalone.sh"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "fast-check": "^4.10.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.2"
  }
}

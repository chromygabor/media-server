{
  "name": "media-server-workspace",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "keys": "pnpm --silent --filter @chromygabor/media-server exec media-keys",
    "sign": "pnpm --silent --filter @chromygabor/media-server exec media-sign --apps secrets/apps.local.json",
    "test:docker": "pnpm --filter @chromygabor/media-server test:docker",
    "image:build": "bash server/scripts/image-build.sh",
    "server:deploy": "server/deploy/deploy.sh",
    "dev-media": "pnpm --filter @chromygabor/media-server dev-media"
  }
}
